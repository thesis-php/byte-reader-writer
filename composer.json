{
    "name": "thesis/byte-reader-writer",
    "description": "An implementation for thesis/byte-order.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesisphp/people"
        }
    ],
    "require": {
        "php": "^8.3",
        "thesis/byte-order": "^0.2.0",
        "thesis/byte-reader": "^0.3.1",
        "thesis/byte-writer": "^0.2.2",
        "thesis/endian": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Thesis\\ByteReaderWriter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\ByteReaderWriter\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
